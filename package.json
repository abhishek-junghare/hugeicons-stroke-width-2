{
  "name": "hugeicons-stroke-width-2",
  "description": "Hugeicons with stroke width 2 for Iconify",
  "version": "1.2.35",
  "main": "index.js",
  "module": "index.mjs",
  "types": "index.d.ts",
  "homepage": "https://github.com/abhishek-junghare/hugeicons-stroke-width-2",
  "bugs": {
    "url": "https://github.com/abhishek-junghare/hugeicons-stroke-width-2/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/abhishek-junghare/hugeicons-stroke-width-2"
  },
  "license": "MIT",
  "exports": {
    "./*": "./*",
    ".": {
      "types": "./index.d.ts",
      "require": "./index.js",
      "import": "./index.mjs"
    },
    "./icons.json": "./icons.json",
    "./info.json": "./info.json"
  },
  "iconSet": {
    "icons": "icons.json",
    "info": "info.json"
  },
  "dependencies": {
    "@iconify/types": "^2.0.0"
  },
  "keywords": [
    "hugeicons",
    "iconify",
    "stroke width 2"
  ]
}